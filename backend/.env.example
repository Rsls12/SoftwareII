# Copiar este archivo como .env (en esta misma carpeta backend/) y llenar los valores.
# Formato .properties: CLAVE=valor, sin comillas.

# Base de datos (Supabase PostgreSQL) - Supabase > Project Settings > Database
DB_URL=jdbc:postgresql://<host-del-pooler>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<id-del-proyecto>
DB_PASSWORD=<contraseña-de-la-base>

# Supabase Storage - Supabase > Project Settings > API Keys (secret key)
SUPABASE_URL=https://<id-del-proyecto>.supabase.co
SUPABASE_KEY=<sb_secret_...>
SUPABASE_BUCKET=objetos
